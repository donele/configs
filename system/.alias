if [ -n "$BASH_VERSION" ]; then
  alias s="source ~/.bashrc"
elif [ -n "$ZSH_VERSION" ]; then
  alias s="source ~/.zshrc"
fi

alias cdf="cd /fsx/jlee; ls"
alias cdc="cd /fsx/jlee/repos/quant-research/packages/configs"
alias cdw="cd /fsx/jlee/repos/quant-research/workspace"

alias vi='vim'
alias lt='ls -lrt'
alias ll='ls -al'
alias tf='tail -f'

alias ta='tmux a'
alias tls='tmux ls'
alias tk='tmux kill-session'

alias gt='git status'
alias ga='git add'
alias gw='git worktree'
alias gc='git commit -v'
alias gd='git diff'
alias gl='git log -3 --oneline'
alias gll='git log -6 --oneline'
alias glll='git log -10 --oneline'
alias gllll='git log -20 --oneline'
alias glllll='git log -40 --oneline'
alias gb='git branch'

alias py='python'
alias br='cmake --preset conan-release; cmake --build ./build -j 16'
alias bd='cmake --preset conan-debug; cmake --build ./debug -j 16'
alias idea="/opt/idea-IC-242.21829.142/bin/idea"
alias cmake_debug="cmake -DCMAKE_BUILD_TYPE=Debug"
alias mergepdf='gs -q -dNOPAUSE -dBATCH -sDEVICE=pdfwrite -sOutputFile=_merged.pdf'
alias path='echo -e ${PATH//:/\\n}'

